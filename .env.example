# Formspree form ID: the value after /f/ in your public form URL.
# Set the recipient email in your Formspree dashboard.
NEXT_PUBLIC_FORMSPREE_ID=
# Primary production origin; other origins are rejected as canonical URLs.
NEXT_PUBLIC_SITE_URL=https://shivasai.is-a.dev
# Optional: HTML verification tokens from the webmaster consoles (not entire tags).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Optional analytics: both values are required.
UMAMI_DOMAIN=
UMAMI_SITE_ID=
